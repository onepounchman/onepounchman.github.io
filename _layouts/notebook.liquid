<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% if page.title != 'about' %}{{ page.title | capitalize }} · {% endif %}
      {{ site.first_name }}
      {{ site.last_name }}
    </title>
    <meta
      name="description"
      content="Wenbo Zhang — Applied Scientist on the Accio team at Alibaba, working on agentic post-training. Research in large language models and trustworthy AI."
    >
    <meta property="og:title" content="Wenbo Zhang">
    <meta
      property="og:description"
      content="Applied Scientist on the Accio team at Alibaba, working on agentic post-training. Large language models and trustworthy AI."
    >
    <meta property="og:image" content="{{ '/assets/img/wenbo-corgi.png' | absolute_url }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='80'%3E🌱%3C/text%3E%3C/svg%3E"
    >
    <link rel="stylesheet" href="{{ '/assets/css/notebook.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/academicons.min.css' | relative_url }}">
  </head>
  <body>
    <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="icon-greeting" viewBox="0 0 24 24">
          <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/>
          <path d="M8 10h8M8 14h5"/>
        </symbol>
        <symbol id="icon-research" viewBox="0 0 24 24">
          <path d="M9 18h6M10 21h4M8.7 14.7a6 6 0 1 1 6.6 0c-.8.6-1.3 1.6-1.3 3.3h-4c0-1.7-.5-2.7-1.3-3.3Z"/>
          <path d="M10 9.5 12 12l2-2.5M12 12v6"/>
        </symbol>
        <symbol id="icon-publications" viewBox="0 0 24 24">
          <path d="M12 5.5C9 3.7 5.5 3.5 2 4.5v15c3.5-1 7-.8 10 1 3-1.8 6.5-2 10-1v-15c-3.5-1-7-.8-10 1Zm0 0v15"/>
          <path d="M5.5 8.5c1.1-.1 2.2 0 3.3.3M5.5 12c1.1-.1 2.2 0 3.3.3M15.2 8.8c1.1-.3 2.2-.4 3.3-.3M15.2 12.3c1.1-.3 2.2-.4 3.3-.3"/>
        </symbol>
        <symbol id="icon-experience" viewBox="0 0 24 24">
          <rect x="3" y="7" width="18" height="14" rx="2"/>
          <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 11.5a22 22 0 0 0 18 0M12 11v4"/>
        </symbol>
        <symbol id="icon-service" viewBox="0 0 24 24">
          <circle cx="9" cy="7" r="3.5"/>
          <path d="M2 21v-2a7 7 0 0 1 11-5.7M16 3.5a3.5 3.5 0 0 1 0 7M15 18l2.2 2.2L22 15.5"/>
        </symbol>
        <symbol id="icon-education" viewBox="0 0 24 24">
          <path d="m2 9 10-5 10 5-10 5L2 9ZM6 11v6c3.6 2.7 8.4 2.7 12 0v-6M22 9v7"/>
        </symbol>
        <symbol id="icon-news" viewBox="0 0 24 24">
          <path d="m4 9 13-5v14L4 13H2V9h2ZM6 14l2 6h4l-3-5M21 8v6"/>
        </symbol>
      </defs>
    </svg>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="notebook">
      <header class="page-heading">
        <h1><a href="{{ '/' | relative_url }}">Wenbo Zhang</a></h1>
      </header>
      <div class="page-grid">
        <aside class="sidebar" aria-label="Profile and contact">
          <div class="portrait">
            <img
              src="{{ '/assets/img/wenbo-corgi.png' | relative_url }}"
              alt="Wenbo holding a corgi beside a river in the mountains"
              width="1562"
              height="2724"
            >
          </div>
          <div class="profile-details">
            <p>
              <strong>Email</strong><br>
              <a href="mailto:wenboz444@gmail.com">wenboz444@gmail.com</a>
            </p>
          </div>
          <nav class="social-links" aria-label="Elsewhere">
            <a class="social-link github" href="https://github.com/{{ site.github_username }}"
              ><span class="brand-icon" aria-hidden="true">&#xf09b;</span> GitHub</a
            >
            <a class="social-link scholar" href="https://scholar.google.com/citations?user={{ site.scholar_userid }}"
              ><i class="ai ai-google-scholar" aria-hidden="true"></i> Google Scholar</a
            >
            <a class="social-link linkedin" href="https://www.linkedin.com/in/{{ site.linkedin_username }}/"
              ><span class="linkedin-icon" aria-hidden="true">in</span> LinkedIn</a
            >
            <a class="social-link twitter" href="https://twitter.com/{{ site.x_username }}"><span aria-hidden="true">𝕏</span> Twitter / X</a>
            <a class="social-link resume" href="{{ '/assets/pdf/cv.pdf' | relative_url }}"><span aria-hidden="true">▤</span> Resume</a>
          </nav>
          <nav class="section-links" aria-label="Page sections">
            {% if page.title == 'about' %}
              <a href="#research">Research interests</a>
              <a href="#news">Recent news</a>
              <a href="#publications">Selected publications</a>
              <a href="#experience">Industry experience</a>
              <a href="#service">Academic service</a>
              <a href="#education">Education</a>
            {% else %}
              <a href="{{ '/' | relative_url }}">Home</a>
            {% endif %}
          </nav>
        </aside>
        <main id="main" class="main-content">{{ content }}</main>
      </div>
      <footer class="page-footer">© {{ site.time | date: '%Y' }} Wenbo Zhang</footer>
    </div>
    <script>
      // Always open the news window at the most recent announcement.
      window.addEventListener('pageshow', function () {
        document.querySelectorAll('.news-scroll').forEach(function (news) {
          news.scrollTop = 0;
        });
      });
    </script>
  </body>
</html>
